# Binary increment as a Turing machine. You show three transitions; the engine learns the table.
machine inc
  start carry
  blank _
  carry 1 -> 0 left carry
  carry 0 -> 1 left halt
  carry _ -> 1 left halt
end

run inc on 1011
run inc on 0
run inc on 111 trace
run inc on 1111111111111111
rules inc
